#!/bin/sh
# Launch Schevana. Chez Scheme is "chez" where Homebrew installs it (Mac)
# and "scheme" elsewhere; "chez" first, since "scheme" may be another
# Scheme there.
#
# A Mac finds a library by its name (libSDL3.dylib, libfreetype.6.dylib) in
# /usr/local/lib and /usr/lib, but Homebrew on Apple silicon keeps its own
# in /opt/homebrew/lib: look there too. (Set from outside, the variable
# would not get here: macOS drops it on the way into /bin/sh.)
if [ "$(uname)" = Darwin ]; then
  DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib:/usr/local/lib:/usr/lib
  export DYLD_FALLBACK_LIBRARY_PATH
fi
for chez in chez scheme; do
  if command -v "$chez" >/dev/null 2>&1; then
    exec "$chez" --script "$(dirname "$0")/main.ss" "$@"
  fi
done
echo "schevana: Chez Scheme not found (as chez or scheme)" >&2
exit 1
