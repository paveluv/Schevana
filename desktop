#!/usr/bin/env scheme-script
;;; desktop — starts Schevana's desktop, a world of windows, apps and
;;; styles on top of the core, from (schevana desktop main).
;;;
;;;   ./desktop [--size WxH] [--fullscreen] [--headless] [--fork]
;;;                      [--hacker] [--eval EXPR]... [FOLDER]...
;;;   ./desktop --install-desktop | --uninstall-desktop
;;;
;;; --hacker runs the hacker edition, where every library's names, its
;;; internals included, can be seen and redefined live. Each FOLDER is
;;; added to the library search and loads with the world: `demo` adds the
;;; demos' apps. Each --eval expression runs once the world has loaded,
;;; for example
;;;
;;;   --eval '(after 2000 (lambda () (png-write-screen-then "s.png" \
;;;                                    (lambda (p) (quit!)))))'

(import (chezscheme))

(let ([root (path-parent (car (command-line)))])
  (load (string-append (if (string=? root "") "." root) "/src/launch.ss"))
  ((eval 'schevana-launch) root '(schevana desktop main) 'desktop-main
   (command-line-arguments)))
