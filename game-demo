#!/usr/bin/env scheme-script
;;; game-demo — starts Fireflies, a game built on the core alone, with
;;; no desktop: the game has the screen to itself (games fireflies). The
;;; same game also runs as an app on the desktop: type
;;; (import (games fireflies)) and (fireflies) at a REPL.
;;;
;;;   ./game-demo [--size WxH] [--fullscreen] [--headless]

(import (chezscheme))

(let ([root (path-parent (car (command-line)))])
  (load (string-append (if (string=? root "") "." root) "/src/launch.ss"))
  ((eval 'schevana-launch) root '(games fireflies) 'fireflies-main
   (command-line-arguments)))
